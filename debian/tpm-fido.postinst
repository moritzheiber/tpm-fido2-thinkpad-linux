#!/bin/sh
set -e

case "$1" in
  configure)
    if [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules || true
      udevadm trigger --subsystem-match=misc --action=change || true
      udevadm trigger --subsystem-match=tpmrm --action=change || true
    fi
    if command -v modprobe >/dev/null 2>&1; then
      modprobe uhid || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
