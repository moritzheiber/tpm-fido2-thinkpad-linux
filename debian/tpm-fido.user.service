[Unit]
Description=TPM-FIDO2 virtual security key
Documentation=https://github.com/moritzheiber/tpm-fido2-thinkpad-linux
ConditionSecurity=tpm2
ConditionKernelModuleLoaded=uhid
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tpm-fido --tray
Restart=on-failure
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=60

NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
PrivateTmp=true
PrivateMounts=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/uhid rw

MemoryHigh=64M
MemoryMax=128M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=default.target
