[Unit]
Description=TPM-FIDO2 virtual security key
Documentation=https://github.com/mc256/tpm-fido2-thinkpad-linux
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tpm-fido --mode=daemon --tray
Restart=on-failure
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
