[Unit]
Description=TPM-FIDO2 virtual security key
Documentation=https://github.com/moritzheiber/tpm-fido2-thinkpad-linux
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tpm-fido --mode=daemon --tray
Restart=on-failure
RestartSec=2
RestartSteps=10
RestartMaxDelaySec=60
MemoryHigh=64M
MemoryMax=128M
TasksMax=64
LimitNOFILE=256

[Install]
WantedBy=default.target
